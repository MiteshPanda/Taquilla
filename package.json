{
  "name": "taquilla",
  "version": "0.0.0",
  "private": true,
  "description": "A match-ticket booking engine that can't double-sell, and proves it under load.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiteshPanda/Taquilla.git"
  },
  "workspaces": [
    "api",
    "payments-mock",
    "web"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "npm run dev --workspace=@taquilla/api",
    "migrate": "npm run migrate --workspace=@taquilla/api && npm run migrate --workspace=@taquilla/payments-mock",
    "reset": "npm run reset --workspace=@taquilla/api",
    "tokens": "npm run tokens --workspace=@taquilla/api",
    "sweeper": "npm run sweeper --workspace=@taquilla/api",
    "payments": "npm run dev --workspace=@taquilla/payments-mock",
    "audit": "npm run audit --workspace=@taquilla/api"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --check"
    ],
    "*.{json,yml,yaml,css,html}": "prettier --check"
  }
}
