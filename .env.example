NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://taquilla:taquilla@localhost:5432/taquilla
PORT=3000
# Required, at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
# How long a login token lasts: a number and a unit (s, m, h or d)
JWT_EXPIRES_IN=1h
BOOKING_STRATEGY=lock
HOLD_SECONDS=300
SWEEP_INTERVAL_SECONDS=10
PAYMENTS_URL=http://localhost:4000
# Payment mock (payments-mock/): its port, then the faults it adds to each key's first attempt
PAYMENTS_PORT=4000
DECLINE_RATE=0.05
LOST_RESPONSE_RATE=0.02
LATENCY_MIN_MS=100
LATENCY_MAX_MS=800
SEED_PASSWORD=taquilla-dev
RACE_DELAY_MS=0
# Web (web/): the API address. Vite bakes it into the build, so a change needs a rebuild.
VITE_API_URL=http://localhost:3000
# The seeded fans' password (SEED_PASSWORD), for the page's "Log in as demo fan" button.
# It ends up in the page for anyone to read, so use it only for shared demo accounts.
VITE_DEMO_PASSWORD=taquilla-dev
